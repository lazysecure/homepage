# Optional GitHub Personal Access Token (public read-only scope recommended)
# Server-side only — never prefix with NEXT_PUBLIC_
# Raises GitHub REST API rate limit from 60/hr to 5,000/hr.
GITHUB_TOKEN=""

# Canonical site URL for metadata (e.g. https://critical-dummy.github.io or custom domain)
NEXT_PUBLIC_SITE_URL=""

# APP_URL: Automatically injected by the hosting environment when available.
APP_URL=""
